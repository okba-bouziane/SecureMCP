# HTTP server
PORT=3000
HOST=0.0.0.0

# SQLite file (created and seeded on first start)
DB_PATH=./data/securemcp.db

# Keycloak — the server only trusts tokens whose `iss` and `aud` match these.
KEYCLOAK_ISSUER=http://localhost:8080/realms/securemcp
# Optional: defaults to ${KEYCLOAK_ISSUER}/protocol/openid-connect/certs.
# Override when the server reaches Keycloak through a different hostname (e.g. Docker).
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/securemcp/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=mcp-server

# Keycloak bootstrap admin (docker compose only)
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin

# Host port for the MCP server (docker compose only)
MCP_PORT=3000
